Using Web Search with Gemini 3.5 Flash
Gemini 3.5 Flash is optimized for default sampling, so the API does not apply a temperature value to requests for this model. Omit it rather than setting it — a value passed here has no effect on the response.

Python
Python
Copy
# Install required packages
# %pip install uuid openai

# Initiate OpenAI client with following mandatory settings:
# base_url: set JLL GPT API endpoint
# api_key: set to jwt token
# subscription-key header: set to APIM subscription key
# jll-request-id: correlation id that is used to trace the request in the API log, faciltating troubleshooting.
# Use ODIC token for jwt_token. ODIC token is acquired from user UI login and contains information about the actual user.

import uuid
from openai import OpenAI

api_url = "https://api-qa.jll.com/csp/chat-service/api/v1"
jwt_token = ""   # Replace with your access token
subscription_key = "" # Replace with your subscription key

correlation_id = str(uuid.uuid4())

client = OpenAI(
    api_key=jwt_token,
    base_url=api_url,
    default_headers={
        "Subscription-Key": subscription_key,
        'jll-request-id': correlation_id
    }
)

# Invoke chat completion API and get response
try:
    chat_completion = client.chat.completions.create(
        messages=[
            {
                "role": "system",
                "content": "You are an assistant"
            },
            {
                "role": "user",
                "content": "Who is the prime minister of Canada?",
            }
        ],
        model="GEMINI_35_FLASH",
        max_tokens=2000,
        extra_body={
            "web_search_options": {
                "enabled": True
            }
        }
    )

    print(chat_completion.choices[0].message.content)

except Exception as e:
    print(f'HTTP Request failed (correlation_id: {correlation_id}):', e)
